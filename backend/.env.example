APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://user:password@localhost:5432/zira?sslmode=disable
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5001,http://localhost:5002

# Clerk JWT verification. Use the PEM public key from Clerk's JWT verification settings.
CLERK_JWT_KEY=
CLERK_ISSUER=
CLERK_AUDIENCE=

# Only for local development without a Clerk session. Never enable in production.
ALLOW_DEV_AUTH=false
DEV_USER_ID=
DEV_USER_ROLE=investisseur

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=ZIRA INVEST <notifications@zira-invest.cd>

# Optional absolute URLs included in notification links
APP_PUBLIC_URL=http://localhost:3000
