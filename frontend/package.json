{
  "name": "zira-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:investisseur",
    "dev:investisseur": "npm run dev --workspace=@zira/app-investisseur",
    "dev:porteur": "npm run dev --workspace=@zira/app-porteur",
    "dev:moderateur": "npm run dev --workspace=@zira/app-moderateur",
    "build": "npm run build:all",
    "build:all": "npm run build:investisseur && npm run build:porteur && npm run build:moderateur",
    "build:investisseur": "npm run build --workspace=@zira/app-investisseur",
    "build:porteur": "npm run build --workspace=@zira/app-porteur",
    "build:moderateur": "npm run build --workspace=@zira/app-moderateur",
    "preview": "npm run preview --workspace=@zira/app-investisseur",
    "typecheck": "npm run typecheck:investisseur && npm run typecheck:porteur && npm run typecheck:moderateur",
    "typecheck:investisseur": "npm run typecheck --workspace=@zira/app-investisseur",
    "typecheck:porteur": "npm run typecheck --workspace=@zira/app-porteur",
    "typecheck:moderateur": "npm run typecheck --workspace=@zira/app-moderateur",
    "lint": "npm run typecheck"
  },
  "dependencies": {
