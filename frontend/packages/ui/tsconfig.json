{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/lib/utils": ["src/lib/utils.ts"],
      "@/lib/hero-icons-compat": ["src/lib/hero-icons-compat.tsx"],
      "@/lib/*": ["src/lib/*", "../shared/src/lib/*"],
      "@/types": ["../shared/src/types.ts"],
      "@/contexts/*": ["../shared/src/contexts/*"],
      "@/hooks/*": ["src/hooks/*"],
      "@/components/*": ["src/components/*"],
      "@/*": ["src/*"],
      "@zira/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
